<%# YouTube Automation client: channel-focused layout (shown instead of the store layout) %>
<%
  const ch = user.channel || {};
  const editLink = base + '/users/' + user.id + '/edit';
  const dealStatus = s => ({ Delivered: 'Paid', Pending: 'Pending', 'In transit': 'Invoiced', Returned: 'Cancelled' }[s] || s);
  const dealPill = s => ({ Paid: 'g', Pending: 'a', Invoiced: 'b', Cancelled: 'r' }[s] || 'n');
  const monetPill = s => ({ Monetized: 'g', 'Under review': 'a', 'Not yet eligible': 'n', Demonetized: 'r' }[s] || 'n');
  const pct = v => (v === null || v === undefined ? '—' : (+v).toFixed(1) + '%');
%>
<div class="grid g4 mb">
  <div class="card kpi"><div class="lbl"><span class="ic red"><%- icon('eye') %></span>Views</div><div class="val"><%= h.short(ch.views) %></div><div class="delta">Last 28 days</div></div>
  <div class="card kpi"><div class="lbl"><span class="ic amber"><%- icon('clock') %></span>Watch time (h)</div><div class="val"><%= h.short(ch.watchHours) %></div><div class="delta">Last 28 days</div></div>
  <div class="card kpi"><div class="lbl"><span class="ic green"><%- icon('users') %></span>Subscribers</div><div class="val"><%= h.isNum(ch.subscribers) ? (ch.subscribers >= 0 ? '+' : '') + h.short(ch.subscribers) : '—' %></div><div class="delta">Gained, last 28 days</div></div>
  <div class="card kpi"><div class="lbl"><span class="ic blue"><%- icon('message') %></span>New comments</div><div class="val"><%= h.num(ch.comments) %></div><div class="delta">Last 28 days</div></div>
</div>

<div class="card mb">
  <div class="card-head">
    <div><h3 class="svc-label"><img class="brand-mini" src="<%= base %>/img/brands/youtube.svg" alt="">Daily views</h3><div class="cap">Last 28 days</div></div>
  </div>
  <div data-chart="<%= JSON.stringify({ type: 'line', unit: 'count', points: ch.daily || [], height: 280, empty: 'No daily views entered yet.' }) %>"></div>
</div>

<div class="grid split mb">
  <% const earns = ['month', 'year', 'week'].some(r => (user.sales?.[r] || []).some(p => Number(p.amount) > 0)); %>
  <% if (!earns && yt.monetization && yt.monetization !== 'Monetized') { %>
  <div class="card">
    <div class="card-head"><div><h3>Estimated ad revenue</h3><div class="cap">Not monetized yet</div></div></div>
    <div class="chart-empty" style="height:300px"><div><span class="ic amber" style="margin:0 auto 10px;display:grid"><%- icon('clock') %></span>
      Partner Program status: <b><%= yt.monetization %></b>.<br>Ad revenue starts once YouTube approves the channel<br><span class="muted" style="font-size:13px">(1,000 subscribers and 4,000 public watch hours in the last 12 months).</span></div></div>
  </div>
  <% } else { %>
  <div class="card">
    <div class="card-head">
      <div><h3>Estimated ad revenue</h3><div class="cap" id="bars-summary"></div></div>
      <div class="tabs no-print" id="bars-tabs" role="tablist">
        <% ranges.forEach(r => { %><button type="button" role="tab" data-range="<%= r %>" class="<%= range === r ? 'on' : '' %>"><%= labels[r] %></button><% }) %>
      </div>
    </div>
    <div id="bars-chart"></div>
  </div>
  <% } %>
  <div class="card" style="height:100%">
    <div class="card-head" style="margin-bottom:0"><h3>Channel overview</h3></div>
    <div class="kv big"><span>Total subscribers</span><span class="v"><%= h.short(yt.totalSubscribers) %></span></div>
    <div class="kv big"><span>Avg view duration</span><span class="v"><%= yt.avgViewDuration || '—' %></span></div>
    <div class="kv big"><span>Impressions CTR</span><span class="v"><%= pct(yt.ctr) %></span></div>
    <div class="kv big"><span>RPM <span class="muted" style="font-size:12.5px">per 1,000 views</span></span><span class="v"><%= yt.rpm ? h.money(yt.rpm, { cents: true }) : '—' %></span></div>
    <div class="kv big"><span>Uploads <span class="muted" style="font-size:12.5px">last 28 days</span></span><span class="v"><%= yt.uploads.length ? yt.uploads28 : '—' %><% if (yt.scheduled) { %> <span class="muted" style="font-size:12.5px">+<%= yt.scheduled %> scheduled</span><% } %></span></div>
  </div>
</div>

<div class="grid split mb">
  <div class="card" style="padding:18px 22px">
    <div class="card-head"><h3>Recent uploads</h3><a class="link no-print" style="font-size:14px" href="<%= editLink %>">Update uploads</a></div>
    <% if (yt.uploads.length) { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Video</th><th>Published</th><th class="r">Length</th><th class="r">Views</th><th>Status</th></tr></thead>
      <tbody>
        <% yt.uploads.forEach(v => { %>
          <tr><td class="b"><%= v.title %></td><td class="muted" style="white-space:nowrap"><%= h.shortDate(v.date) %></td><td class="r muted"><%= v.length || '—' %></td><td class="r"><%= v.status === 'Scheduled' ? '—' : h.num(v.views) %></td><td><span class="pill <%= v.status === 'Published' ? 'g' : v.status === 'Scheduled' ? 'b' : 'n' %>"><%= v.status %></span></td></tr>
        <% }) %>
      </tbody>
    </table></div>
    <% } else { %><div class="empty-state" style="padding:28px"><p>No uploads recorded yet. <a class="link" href="<%= editLink %>">Add them on the Edit page</a></p></div><% } %>
  </div>
  <div class="card" style="height:100%">
    <div class="card-head" style="margin-bottom:0"><h3>Monetization</h3></div>
    <div class="kv"><span>Partner Program</span><% if (yt.monetization) { %><span class="pill <%= monetPill(yt.monetization) %>"><%= yt.monetization %></span><% } else { %><span>—</span><% } %></div>
    <div class="kv"><span>Current balance</span><span class="v"><%= h.money(user.balance) %></span></div>
    <div class="kv"><span>Next AdSense payout</span><span class="v"><%= user.nextPayment ? h.shortDate(user.nextPayment) : '—' %></span></div>
    <% if (yt.split) { const s = yt.split; %>
      <div style="padding:14px 0 4px;font-size:13px;color:var(--muted)">Revenue sources · last 30 days</div>
      <% [['Ads', s.ads, '#ff3131'], ['Memberships', s.memberships, '#ff7a7a'], ['Sponsorships', s.sponsorships, '#231f20'], ['Affiliate', s.affiliate, '#8a8586']].filter(x => x[1] > 0).forEach(([label, v, color]) => { %>
        <div class="rev-row"><span><i style="background:<%= color %>"></i><%= label %></span><b><%= h.money(v) %></b></div>
        <div class="progress" style="margin-bottom:8px"><span style="width:<%= (v / yt.splitTotal * 100).toFixed(1) %>%;background:<%= color %>"></span></div>
      <% }) %>
    <% } %>
    <div class="kv" style="border-top:1px solid var(--line);margin-top:6px"><span>Investment</span><span class="v"><%= h.money(user.investment) %></span></div>
  </div>
</div>

<div class="grid split mb">
  <div class="card" style="padding:18px 22px">
    <div class="card-head"><h3>Brand deals &amp; income</h3><a class="link no-print" style="font-size:14px" href="<%= base %>/orders?user=<%= user.id %>">View all</a></div>
    <% if (yt.deals.length) { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Deal</th><th>Date</th><th>Status</th><th class="r">Amount</th></tr></thead>
      <tbody>
        <% yt.deals.forEach(o => { const st = dealStatus(o.status); %>
          <tr><td class="b"><%= o.product %></td><td class="muted" style="white-space:nowrap"><%= h.longDate(o.date) %></td><td><span class="pill <%= dealPill(st) %>"><%= st %></span></td><td class="r b"><%= h.money(o.amount, { cents: true }) %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
    <% } else { %><div class="empty-state" style="padding:28px"><p>No brand deals recorded yet.</p></div><% } %>
  </div>
  <div class="card" style="height:100%">
    <div class="card-head" style="margin-bottom:0"><h3>Contact</h3></div>
    <div class="kv"><span>Email</span><span class="muted"><%= user.email ? 'Hidden for privacy' : '—' %></span></div>
    <div class="kv"><span>Phone</span><% if (user.phone) { %><a href="tel:<%= user.phone.replace(/[^\d+]/g, '') %>" style="text-decoration:none;color:var(--ink)"><%= user.phone %></a><% } else { %><span>—</span><% } %></div>
    <div class="kv"><span>Country</span><span><%= user.country || '—' %></span></div>
    <div class="kv"><span>Channel link</span><span class="muted"><%= user.storeLink ? 'Hidden for privacy' : '—' %></span></div>
    <div class="kv"><span>Messages</span><span class="v"><%= h.num(user.communications) %></span></div>
    <%- include('data-source') %>
  </div>
</div>
