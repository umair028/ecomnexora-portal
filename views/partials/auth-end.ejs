    </div>
  </main>
</div>
<div class="toasts" id="toasts"></div>
<script src="<%= base %>/js/app.js?v=<%= v %>"></script>
<script>
(() => {
  // respect "reduce motion": keep the video on its first frame
  const video = document.querySelector('.lp-video');
  if (video && matchMedia('(prefers-reduced-motion: reduce)').matches) { video.removeAttribute('autoplay'); video.pause(); }
})();
</script>
</body>
</html>
