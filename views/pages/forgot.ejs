<%- include('../partials/auth-start', { title: 'Reset password' }) %>
      <form class="lp-card" method="post" action="<%= base %>/forgot-password">
        <h2>Reset password</h2>
        <% if (sent) { %>
          <div class="lp-alert ok" role="status"><%- icon('check') %><span>If <b><%= email || 'that address' %></b> belongs to an admin account, the account owner has been notified. Another admin can also set a new password from <b>Settings → Security</b>.</span></div>
          <a href="<%= base %>/login" class="btn btn-red btn-block lp-submit">Back to sign in</a>
        <% } else { %>
          <p class="lp-card-sub">Enter the email you sign in with.</p>
          <div class="lp-field"><label for="email">Email</label><input id="email" name="email" type="email" placeholder="you@company.com" required autofocus></div>
          <button class="btn btn-red btn-block lp-submit" type="submit">Send reset request</button>
          <a href="<%= base %>/login" class="lp-back"><%- icon('left') %>Back to sign in</a>
        <% } %>
      </form>
<%- include('../partials/auth-end') %>
