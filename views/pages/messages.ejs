<%- include('../partials/head') %>
<style>
  .inbox{display:grid;grid-template-columns:340px minmax(0,1fr) 290px;height:calc(100vh - 210px);min-height:520px;padding:0;overflow:hidden}
  .col{border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0;min-width:0}
  .col:last-child{border-right:none}
  .conv-list{overflow-y:auto;flex:1}
  .conv{display:flex;gap:12px;padding:14px 18px;border-bottom:1px solid var(--line);transition:background .15s;position:relative}
  .conv:hover{background:#fafafb}
  .conv.on{background:#fdf3f4;box-shadow:inset 3px 0 0 var(--red)}
  .conv .t{display:flex;justify-content:space-between;gap:8px;font-size:14.5px}
  .conv .p{color:var(--muted);font-size:13.5px;margin-top:3px}
  .conv.unread .p{color:var(--ink-2);font-weight:500}
  .conv .dot{width:8px;height:8px;border-radius:50%;background:var(--red);flex-shrink:0;margin-top:6px}
  .thread{flex:1;overflow-y:auto;padding:22px 26px;display:flex;flex-direction:column;gap:16px;background:#fafafb;scroll-behavior:smooth}
  .bub{max-width:70%;padding:12px 15px;border-radius:15px;font-size:14.5px;line-height:1.5;white-space:pre-wrap;word-wrap:break-word;animation:pop .25s var(--ease)}
  .bub.in{background:#fff;border:1px solid var(--line);border-top-left-radius:4px}
  .bub.out{background:var(--red);color:#fff;margin-left:auto;border-top-right-radius:4px}
  .meta{font-size:12px;color:var(--faint);margin-top:6px}
  .meta.r{text-align:right}
  .day{text-align:center;font-size:12px;color:var(--faint);margin:4px 0}
  .composer{border-top:1px solid var(--line);padding:14px 18px;display:flex;align-items:flex-end;gap:12px;background:#fff}
  .composer textarea{flex:1;min-height:46px;max-height:160px;resize:none;border:1px solid var(--line);border-radius:11px;padding:12px 14px;font-size:15px;line-height:1.4;transition:border-color .2s,box-shadow .2s}
  .composer textarea:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(224,30,47,.14)}
  .send{width:46px;height:46px;border-radius:11px;background:var(--red);color:#fff;display:grid;place-items:center;flex-shrink:0;transition:background .15s,transform .15s}
  .send:hover{background:var(--red-hover);transform:translateY(-1px)}
  .send:active{transform:scale(.94)}
  .send[disabled]{opacity:.5;pointer-events:none}
  .info{padding:20px;overflow-y:auto}
  .info .kv{font-size:14px;padding:12px 0}
  .info .kv a{text-decoration:none;color:var(--ink)}
  .back-btn{display:none}
  @media (max-width:1280px){.inbox{grid-template-columns:300px minmax(0,1fr)}.inbox .info{display:none}}
  @media (max-width:820px){
    .inbox{grid-template-columns:1fr;height:calc(100vh - 190px)}
    .inbox.has-thread .col.list-col{display:none}
    .inbox:not(.has-thread) .col.thread-col{display:none}
    .back-btn{display:inline-grid}
    .bub{max-width:85%}
  }
</style>

<div class="head">
  <div><h1>Messages</h1><div class="sub"><%= unreadTotal ? unreadTotal + ' unread message' + (unreadTotal === 1 ? '' : 's') + '.' : 'You’re all caught up.' %></div></div>
  <button type="button" class="btn btn-red" style="height:44px" data-modal="new-msg"><%- icon('plus') %>New message</button>
</div>

<div class="card inbox <%= query.u && user ? 'has-thread' : '' %>">
  <div class="col list-col">
    <div style="padding:14px 18px;border-bottom:1px solid var(--line)">
      <nav class="tabs" style="display:flex;width:100%">
        <% [['all', 'All'], ['unread', 'Unread'], ['archived', 'Archived']].forEach(([k, l]) => { %>
          <a href="<%= base %>/messages?filter=<%= k %>" class="<%= filter === k ? 'on' : '' %>" style="flex:1;text-align:center"><%= l %></a>
        <% }) %>
      </nav>
    </div>
    <div class="conv-list">
      <% convs.forEach(c => { %>
        <a class="conv <%= user && c.user.id === user.id ? 'on' : '' %> <%= c.unread ? 'unread' : '' %>" href="<%= base %>/messages?u=<%= c.user.id %><%= filter !== 'all' ? '&filter=' + filter : '' %>">
          <span class="av"><%= h.categoryInitials(c.user.serviceId) %></span>
          <div style="flex:1;min-width:0">
            <div class="t"><b style="font-weight:<%= c.unread ? 700 : 600 %>" class="ellipsis client-id"><%= h.clientRef(c.user) %></b><span style="color:var(--faint);font-size:12px;white-space:nowrap"><%= h.timeAgo(c.last.at) %></span></div>
            <div style="display:flex;gap:8px"><div class="p ellipsis" style="flex:1"><%= c.last.from === 'admin' ? 'You: ' : '' %><%= c.last.body %></div><% if (c.unread) { %><span class="dot" title="<%= c.unread %> unread"></span><% } %></div>
          </div>
        </a>
      <% }) %>
      <% if (!convs.length) { %>
        <div class="empty-state" style="padding:40px 20px"><div class="ic red"><%- icon('message') %></div><h4><%= filter === 'unread' ? 'No unread messages' : filter === 'archived' ? 'Nothing archived' : 'No conversations yet' %></h4><p>Start one with <b>New message</b>.</p></div>
      <% } %>
    </div>
  </div>

  <div class="col thread-col">
    <% if (user) { %>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 22px;border-bottom:1px solid var(--line)">
        <div style="display:flex;align-items:center;gap:12px;min-width:0">
          <a href="<%= base %>/messages<%= filter !== 'all' ? '?filter=' + filter : '' %>" class="icon-btn back-btn" aria-label="Back to conversations"><%- icon('left') %></a>
          <span class="av"><%= h.categoryInitials(user.serviceId) %></span>
          <div style="min-width:0"><a href="<%= base %>/users/<%= user.id %>" class="b link client-id" style="color:var(--ink)"><%= h.clientRef(user) %></a><span class="s2 ellipsis"><%= h.serviceCategory(user.serviceId) %> · <%= h.ANON_SUB %></span></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="pill <%= h.pill(user.status) %>"><%= user.status %></span>
          <div class="menu">
            <button type="button" class="icon-btn" data-menu-toggle aria-label="Conversation actions"><%- icon('dots') %></button>
            <div class="dd">
              <a href="<%= base %>/users/<%= user.id %>"><%- icon('user') %>View profile</a>
              <% if (thread.some(m => m.from === 'user')) { %><form method="post" action="<%= base %>/messages/<%= user.id %>/unread"><button type="submit"><%- icon('mailOpen') %>Mark as unread</button></form><% } %>
              <% if (thread.length) { %><form method="post" action="<%= base %>/messages/<%= user.id %>/archive"><button type="submit"><%- icon('archive') %><%= archived ? 'Move to inbox' : 'Archive' %></button></form><% } %>
            </div>
          </div>
        </div>
      </div>
      <div class="thread" id="thread">
        <% let lastDay = ''; thread.forEach(m => { const day = h.longDate(m.at); %>
          <% if (day !== lastDay) { lastDay = day; %><div class="day"><%= day === h.longDate(new Date().toISOString()) ? 'Today' : day %></div><% } %>
          <div>
            <div class="bub <%= m.from === 'admin' ? 'out' : 'in' %>"><%= m.body %></div>
            <div class="meta <%= m.from === 'admin' ? 'r' : '' %>"><%= m.from === 'admin' ? 'You' : h.clientRef(user) %> · <%= h.timeOf(m.at) %></div>
          </div>
        <% }) %>
        <% if (!thread.length) { %><div class="empty-state" style="margin:auto"><p>No messages with <%= h.clientRef(user) %> yet. Say hello below.</p></div><% } %>
      </div>
      <form class="composer" id="composer" method="post" action="<%= base %>/messages" data-no-loading="1">
        <input type="hidden" name="userId" value="<%= user.id %>">
        <label class="sr-only" for="body">Message</label>
        <textarea id="body" name="body" rows="1" placeholder="Write a reply…" title="Enter to send, Shift+Enter for a new line" maxlength="2000" required></textarea>
        <button type="submit" class="send" aria-label="Send message" disabled><%- icon('send') %></button>
      </form>
    <% } else { %>
      <div class="empty-state" style="margin:auto"><div class="ic red"><%- icon('message') %></div><h4>Select a conversation</h4><p>Or start a new one with <b>New message</b>.</p></div>
    <% } %>
  </div>

  <% if (user) { %>
  <div class="col info">
    <div style="text-align:center;padding:6px 0 16px;border-bottom:1px solid var(--line)">
      <span class="av lg" style="margin:0 auto 10px"><%= h.categoryInitials(user.serviceId) %></span>
      <div class="b client-id" style="font-size:16px"><%= h.clientRef(user) %></div>
      <span class="s2"><%= h.serviceCategory(user.serviceId) %> · <%= h.ANON_SUB %></span>
    </div>
    <div class="kv"><span>Email</span><span class="muted"><%= user.email ? 'Hidden for privacy' : '—' %></span></div>
    <div class="kv"><span>Phone</span><span><%= user.phone || '—' %></span></div>
    <div class="kv"><span>Balance</span><b><%= h.money(user.balance) %></b></div>
    <div class="kv"><span>Next payment</span><b><%= user.nextPayment ? h.shortDate(user.nextPayment) : '—' %></b></div>
    <div class="kv"><span>Orders</span><b><%= h.num(user.orders) %></b></div>
    <a href="<%= base %>/users/<%= user.id %>" class="btn btn-sm btn-block" style="margin-top:12px">View profile</a>
  </div>
  <% } %>
</div>

<div class="modal" id="new-msg" role="dialog" aria-modal="true" aria-labelledby="nm-title">
  <form class="box" method="post" action="<%= base %>/messages">
    <div class="mh"><h3 id="nm-title">New message</h3><button type="button" class="icon-btn" style="border:none" data-close aria-label="Close"><%- icon('x') %></button></div>
    <div class="mb">
      <div class="field"><label for="nm-user">To</label><div class="select" style="width:100%"><select id="nm-user" name="userId" required>
        <option value="">Choose a client</option>
        <% users.forEach(u => { %><option value="<%= u.id %>" <%= user && user.id === u.id ? 'selected' : '' %>><%= h.clientOption(u) %></option><% }) %>
      </select></div></div>
      <div class="field" style="margin-top:16px"><label for="nm-body">Message</label><textarea id="nm-body" name="body" required maxlength="2000" style="height:130px" autofocus></textarea></div>
    </div>
    <div class="mf"><button type="button" class="btn btn-sm" data-close>Cancel</button><button type="submit" class="btn btn-sm btn-red"><%- icon('send') %>Send</button></div>
  </form>
</div>

<script>
(() => {
  const thread = document.getElementById('thread');
  const form = document.getElementById('composer');
  if (!form) return;
  const ta = form.querySelector('textarea');
  const btn = form.querySelector('.send');
  thread.scrollTop = thread.scrollHeight;
  const grow = () => { ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight + 2, 160) + 'px'; btn.disabled = !ta.value.trim(); };
  ta.addEventListener('input', grow);
  ta.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const body = ta.value.trim();
    if (!body) return;
    btn.disabled = true;
    try {
      const r = await fetch('<%= base %>/messages', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ userId: form.userId.value, body }) });
      const data = await r.json();
      if (!r.ok) throw new Error(data.error || 'Could not send.');
      thread.querySelector('.empty-state')?.remove();
      const wrap = document.createElement('div');
      wrap.innerHTML = '<div class="bub out"></div><div class="meta r"></div>';
      wrap.firstChild.textContent = data.body;
      wrap.lastChild.textContent = 'You · ' + data.time;
      thread.appendChild(wrap);
      thread.scrollTop = thread.scrollHeight;
      ta.value = ''; grow(); ta.focus();
    } catch (err) {
      toast(err.message || 'Could not send.', 'error');
      btn.disabled = false;
    }
  });
})();
</script>
<%- include('../partials/foot') %>
