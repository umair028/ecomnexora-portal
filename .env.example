# Copy this file to .env and change the values.
PORT=3000

# Folder the portal lives in on the website. "/portal" -> https://ecomnexora.com/portal
# Leave empty when it has its own subdomain (e.g. https://portal.ecomnexora.com).
BASE_PATH=

# Background video on the sign-in pages (MP4). Leave unset to use the default video,
# set to your own file (e.g. https://ecomnexora.com/assets/portal-login.mp4), or set empty to turn it off.
# LOGIN_VIDEO_URL=

# Set to production on the live server (long asset caching, secure cookies over HTTPS).
NODE_ENV=development

# Long random string used to sign session cookies. Set this in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin login created the first time the app starts (or after `npm run seed`).
# After that, change the email and password from Settings in the portal.
ADMIN_EMAIL=admin@ecomnexora.com
ADMIN_PASSWORD=nexora-admin

# Business accounts: fetch client data automatically from their links.
# YouTube Data API key (Google Cloud console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key).
# Gives public channel stats and recent uploads. Shopify needs no key here: each store's token is entered on the client form.
# YOUTUBE_API_KEY=
