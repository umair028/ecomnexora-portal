{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,lib/**,routes/**,node_modules/three/build/**,node_modules/three/examples/jsm/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
